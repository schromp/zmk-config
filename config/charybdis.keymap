#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        Base {
            bindings = <
&kp ESC         &kp N1  &kp N2  &kp N3            &kp N4     &kp N5          &kp N6         &kp N7       &kp N8     &kp N9   &kp N0     &kp MINUS
&kp TAB         &kp Q   &kp W   &kp E             &kp R      &kp T           &kp Y          &kp U        &kp I      &kp O    &kp P      &kp BACKSPACE
&kp LEFT_SHIFT  &kp A   &kp S   &kp D             &kp F      &kp G           &kp H          &kp J        &kp K      &kp L    &kp SEMI   &kp RIGHT_SHIFT
&kp ESCAPE      &kp Z   &kp X   &kp C             &kp V      &kp B           &kp N          &kp M        &kp COMMA  &kp DOT  &kp SLASH  &kp APOS
                                &kp LEFT_CONTROL  &kp SPACE  &kp LEFT_ALT    &kp RIGHT_ALT  &lt 2 ENTER
                                                  &mo 2      &kp LGUI        &kp RGUI
            >;
        };

        layer_2 {
            bindings = <
&kp ESC           &kp N1  &kp N2  &kp N3            &kp N4     &kp N5          &trans  &trans  &trans  &trans  &trans  &trans
&kp TAB           &kp T   &kp Q   &kp W             &kp E      &kp R           &trans  &trans  &trans  &trans  &trans  &trans
&kp LSHFT         &kp G   &kp A   &kp S             &kp D      &kp F           &trans  &trans  &trans  &trans  &trans  &trans
&kp LEFT_CONTROL  &kp Z   &kp X   &kp C             &kp V      &kp B           &trans  &trans  &trans  &trans  &trans  &trans
                                  &kp LEFT_CONTROL  &kp SPACE  &kp LEFT_ALT    &trans  &trans
                                                    &to 0      &trans          &trans
            >;
        };

        Lower {
            bindings = <
&sys_reset      &kp EXCLAMATION  &kp HASH      &kp DOLLAR    &kp DOLLAR  &kp PERCENT    &kp CARET  &kp AMPERSAND     &kp ASTERISK       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &none
&none           &bt BT_SEL 0     &bt BT_SEL 1  &bt BT_SEL 2  &kp TILDE   &kp EQUAL      &kp PLUS   &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp TILDE             &none                  &kp BACKSPACE
&kp LEFT_SHIFT  &none            &none         &none         &none       &none          &kp LEFT   &kp DOWN          &kp UP             &kp RIGHT             &none                  &kp RIGHT_SHIFT
&bt BT_CLR      &out OUT_TOG     &to 0         &to 1         &none       &none          &none      &mkp LCLK         &mkp RCLK          &none                 &kp BACKSLASH          &kp GRAVE
                                               &trans        &trans      &trans         &trans     &trans
                                                             &trans      &trans         &trans
            >;
        };
    };
};
