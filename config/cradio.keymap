#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define L_COL 1
#define L_RIGHT 2
#define L_LEFT 3
#define L_TRI 4

/ {
    behaviors {
        ht: hold_tap {
            label = "hold_tap";
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <300>;
            quick-tap-ms = <150>;
            global-quick-tap;
            bindings = <&kp>, <&kp>;
        };

        skq: sticky_key_quick_release {
            compatible = "zmk,behavior-sticky-key";
            label = "STICKY_KEY_QUICK_RELEASE";
            #binding-cells = <1>;
            bindings = <&kp>;
            release-after-ms = <1000>;
            quick-release;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <2 1>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q  &kp W  &kp E  &kp R  &kp T        &kp Y       &kp U  &kp I      &kp O    &kp P
&kp A  &kp S  &kp D  &kp F  &kp G        &kp H       &kp J  &kp K      &kp L    &kp SEMICOLON
&kp Z  &kp X  &kp C  &kp V  &kp B        &kp N       &kp M  &kp COMMA  &kp DOT  &kp FSLH
                     &sl 2  &kp SPACE    &skq LSHFT  &sl 1
            >;
        };

        // symbol layer

        right_layer {
            bindings = <
&kp N1      &kp N2  &kp N3  &kp N4  &kp N5         &kp N6    &kp N7    &kp N8        &kp N9           &kp N0
&kp TAB     &none   &none   &none   &none          &kp LEFT  &kp DOWN  &kp UP_ARROW  &kp RIGHT_ARROW  &kp DELETE
&kp ESCAPE  &none   &none   &none   &none          &none     &none     &none         &none            &none
                            &trans  &key_repeat    &trans    &trans
            >;
        };

        // extend layer

        left_layer {
            bindings = <
&kp EXCLAMATION  &kp AT    &kp HASH   &kp DOLLAR  &kp PERCENT    &kp CARET         &kp AMPERSAND      &kp ASTERISK    &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&sk LALT         &sk LGUI  &sk LSHFT  &sk LCTRL   &sk RALT       &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_BRACE  &kp RIGHT_BRACE       &kp BACKSPACE
&none            &none     &none      &none       &none          &none             &kp PLUS           &kp MINUS       &kp GRAVE             &kp BACKSLASH
                                      &trans      &trans         &trans            &trans
            >;
        };

        // extended symbol layer

        tri_layer {
            bindings = <
&kp F1   &kp F2   &kp F3  &kp F4  &kp F5         &kp F6       &kp F7        &kp F8        &kp F9        &kp F10
&kp F11  &kp F12  &trans  &none   &none          &none        &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &none
&none    &none    &none   &none   &bootloader    &bootloader  &trans        &out OUT_TOG  &bt BT_CLR    &none
                          &trans  &trans         &trans       &trans
            >;
        };
    };
};
